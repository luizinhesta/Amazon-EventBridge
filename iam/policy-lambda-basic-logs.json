{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CriarLogGroupDasFuncoesDoLab",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:<REGIAO>:<ACCOUNT_ID>:*"
    },
    {
      "Sid": "GravarLogsDasFuncoesDoLab",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:<REGIAO>:<ACCOUNT_ID>:log-group:/aws/lambda/<PREFIXO>-*:*"
    }
  ]
}
