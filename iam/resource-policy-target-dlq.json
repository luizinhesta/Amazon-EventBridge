{
  "Version": "2012-10-17",
  "Id": "<PREFIXO>-target-dlq-policy",
  "Statement": [
    {
      "Sid": "PermitirEventBridgeEnviarFalhasDeEntrega",
      "Effect": "Allow",
      "Principal": {
        "Service": "events.amazonaws.com"
      },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:<REGIAO>:<ACCOUNT_ID>:<PREFIXO>-target-dlq",
      "Condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:events:<REGIAO>:<ACCOUNT_ID>:rule/<PREFIXO>-bus/*"
        }
      }
    }
  ]
}
